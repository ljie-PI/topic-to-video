[
 {
  "i": 0,
  "start": 0.033,
  "end": 1.3,
  "text": "GitHub 本周热榜"
 },
 {
  "i": 1,
  "start": 1.467,
  "end": 3.133,
  "text": "排在榜首的是 artcraft，"
 },
 {
  "i": 2,
  "start": 3.367,
  "end": 5.367,
  "text": "定好构图再交由模型生成。"
 },
 {
  "i": 3,
  "start": 5.7,
  "end": 6.967,
  "text": "第二名是 VoiceStudio，"
 },
 {
  "i": 4,
  "start": 7.2,
  "end": 8.967,
  "text": "支持在本地完成克隆与配音。"
 },
 {
  "i": 5,
  "start": 9.2,
  "end": 10.4,
  "text": "第三名是 LibreTV，"
 },
 {
  "i": 6,
  "start": 10.567,
  "end": 12.267,
  "text": "集中搜索并播放多源影视。"
 },
 {
  "i": 7,
  "start": 12.567,
  "end": 13.933,
  "text": "第四名是 context-mode，"
 },
 {
  "i": 8,
  "start": 14.167,
  "end": 16.4,
  "text": "在执行侧过滤日志以降低开销。"
 },
 {
  "i": 9,
  "start": 16.667,
  "end": 18.567,
  "text": "第五名是 scientific-agent-skills，"
 },
 {
  "i": 10,
  "start": 18.8,
  "end": 20.5,
  "text": "为智能体提供科研流程规范。"
 },
 {
  "i": 11,
  "start": 20.933,
  "end": 22.933,
  "text": "第一名，storytold 的 artcraft，"
 },
 {
  "i": 12,
  "start": 23.1,
  "end": 24.767,
  "text": "可控图像视频创作工具，"
 },
 {
  "i": 13,
  "start": 25,
  "end": 27.333,
  "text": "本周新增 20,267 颗 star。"
 },
 {
  "i": 14,
  "start": 27.767,
  "end": 29.833,
  "text": "创作者能在二维画布上自由抠图，"
 },
 {
  "i": 15,
  "start": 30,
  "end": 31.267,
  "text": "把各个元素排布到位。"
 },
 {
  "i": 16,
  "start": 32.2,
  "end": 34.367,
  "text": "创作者能在三维布景中调整相机，"
 },
 {
  "i": 17,
  "start": 34.6,
  "end": 36.2,
  "text": "让前后景呈现明确透视。"
 },
 {
  "i": 18,
  "start": 36.8,
  "end": 39.1,
  "text": "它支持将平面图片转为三维网格，"
 },
 {
  "i": 19,
  "start": 39.433,
  "end": 41.033,
  "text": "方便在场景中旋转布置。"
 },
 {
  "i": 20,
  "start": 41.633,
  "end": 43.167,
  "text": "角色的姿势也能预先微调，"
 },
 {
  "i": 21,
  "start": 43.4,
  "end": 45.3,
  "text": "再交由生成模型渲染出图。"
 },
 {
  "i": 22,
  "start": 45.667,
  "end": 47.433,
  "text": "第二名，debpalash 的 VoiceStudio，"
 },
 {
  "i": 23,
  "start": 47.433,
  "end": 48.4,
  "text": "本地语音工作站，"
 },
 {
  "i": 24,
  "start": 48.7,
  "end": 51.267,
  "text": "本周新增 14,708 颗 star。"
 },
 {
  "i": 25,
  "start": 51.7,
  "end": 52.733,
  "text": "导入授权样本后，"
 },
 {
  "i": 26,
  "start": 52.967,
  "end": 55.133,
  "text": "克隆与语音合成均在本地设备运行。"
 },
 {
  "i": 27,
  "start": 55.567,
  "end": 57.1,
  "text": "它配备专属配音工作区，"
 },
 {
  "i": 28,
  "start": 57.4,
  "end": 59.333,
  "text": "方便对照原声与新生成的音轨。"
 },
 {
  "i": 29,
  "start": 59.767,
  "end": 61.6,
  "text": "系统支持切换多种语音引擎，"
 },
 {
  "i": 30,
  "start": 61.9,
  "end": 63.9,
  "text": "但各引擎对硬件与功能的要求各异。"
 },
 {
  "i": 31,
  "start": 64.333,
  "end": 66.267,
  "text": "软件开源许可不等于模型许可，"
 },
 {
  "i": 32,
  "start": 66.5,
  "end": 68.1,
  "text": "克隆声音必须先获授权。"
 },
 {
  "i": 33,
  "start": 68.7,
  "end": 70.933,
  "text": "第三名，LibreSpark 的 LibreTV，"
 },
 {
  "i": 34,
  "start": 71.1,
  "end": 72.3,
  "text": "自托管影音聚合站，"
 },
 {
  "i": 35,
  "start": 72.533,
  "end": 74.633,
  "text": "本周新增 4,775 颗 star。"
 },
 {
  "i": 36,
  "start": 75.067,
  "end": 76.8,
  "text": "服务端向多个来源并行搜索，"
 },
 {
  "i": 37,
  "start": 77.067,
  "end": 78.8,
  "text": "将检索结果汇聚到统一入口。"
 },
 {
  "i": 38,
  "start": 79.267,
  "end": 80.767,
  "text": "系统能对同名影片测速，"
 },
 {
  "i": 39,
  "start": 81,
  "end": 82.067,
  "text": "用户可一键换源，"
 },
 {
  "i": 40,
  "start": 82.367,
  "end": 84.133,
  "text": "连续失败的线路会被分级停用。"
 },
 {
  "i": 41,
  "start": 84.567,
  "end": 86.333,
  "text": "播放进度保存在本地数据库中，"
 },
 {
  "i": 42,
  "start": 86.667,
  "end": 88.1,
  "text": "并不会自动跨设备同步。"
 },
 {
  "i": 43,
  "start": 88.867,
  "end": 90.533,
  "text": "项目本身不内置影视资源，"
 },
 {
  "i": 44,
  "start": 90.867,
  "end": 93.1,
  "text": "使用者需自行接入合法的第三方源。"
 },
 {
  "i": 45,
  "start": 93.533,
  "end": 96.1,
  "text": "第四名，mksglu 的 context-mode，"
 },
 {
  "i": 46,
  "start": 96.333,
  "end": 97.7,
  "text": "编程 Agent 上下文工具，"
 },
 {
  "i": 47,
  "start": 98,
  "end": 100,
  "text": "本周新增 4,207 颗 star。"
 },
 {
  "i": 48,
  "start": 100.433,
  "end": 103.4,
  "text": "它在子进程中预先运行脚本过滤日志，"
 },
 {
  "i": 49,
  "start": 103.633,
  "end": 105.233,
  "text": "只把关键结果送回上下文。"
 },
 {
  "i": 50,
  "start": 105.833,
  "end": 107.9,
  "text": "技术文档会被分块存入全文索引，"
 },
 {
  "i": 51,
  "start": 108.167,
  "end": 110.233,
  "text": "方便智能体按需检索关键片段。"
 },
 {
  "i": 52,
  "start": 110.667,
  "end": 112.433,
  "text": "系统能将任务事件持久保存，"
 },
 {
  "i": 53,
  "start": 112.733,
  "end": 114.9,
  "text": "但会话恢复效果取决于宿主环境。"
 },
 {
  "i": 54,
  "start": 115.333,
  "end": 118.067,
  "text": "官方展示的压缩比例针对特定测试场景，"
 },
 {
  "i": 55,
  "start": 118.367,
  "end": 119.967,
  "text": "并不构成实际账单保证。"
 },
 {
  "i": 56,
  "start": 120.567,
  "end": 123.533,
  "text": "第五名，K-Dense-AI 的 scientific-agent-skills，"
 },
 {
  "i": 57,
  "start": 123.767,
  "end": 124.5,
  "text": "科研技能库，"
 },
 {
  "i": 58,
  "start": 124.567,
  "end": 126.567,
  "text": "本周新增 3,170 颗 star。"
 },
 {
  "i": 59,
  "start": 127,
  "end": 129.1,
  "text": "该库收录了一百七十七项科研规范，"
 },
 {
  "i": 60,
  "start": 129.4,
  "end": 131.1,
  "text": "由智能体按任务动态加载。"
 },
 {
  "i": 61,
  "start": 131.6,
  "end": 132.8,
  "text": "查询科学数据库时，"
 },
 {
  "i": 62,
  "start": 133.033,
  "end": 134.5,
  "text": "智能体先设筛选条件，"
 },
 {
  "i": 63,
  "start": 134.8,
  "end": 136.1,
  "text": "再逐一核验数据来源。"
 },
 {
  "i": 64,
  "start": 137,
  "end": 138.933,
  "text": "技能文档主要提供实验操作步骤，"
 },
 {
  "i": 65,
  "start": 139.167,
  "end": 141,
  "text": "并不会自动安装底层科研软件。"
 },
 {
  "i": 66,
  "start": 141.367,
  "end": 143.033,
  "text": "规范流程能辅助工具调用，"
 },
 {
  "i": 67,
  "start": 143.3,
  "end": 146.167,
  "text": "但产出的科学结论仍需研究人员严格复核。"
 },
 {
  "i": 68,
  "start": 146.6,
  "end": 147.467,
  "text": "综合本周趋势，"
 },
 {
  "i": 69,
  "start": 147.467,
  "end": 150.833,
  "text": "开源工具更加注重可控工作流与本地自托管处理，"
 },
 {
  "i": 70,
  "start": 151.067,
  "end": 154.2,
  "text": "同时开发者也更加审慎地管理上下文与数据边界。"
 },
 {
  "i": 71,
  "start": 154.967,
  "end": 157.033,
  "text": "如果你喜欢本期整理的开源项目盘点，"
 },
 {
  "i": 72,
  "start": 157.267,
  "end": 158.8,
  "text": "欢迎点赞、关注并收藏，"
 },
 {
  "i": 73,
  "start": 159.033,
  "end": 159.833,
  "text": "我们下期再见！"
 }
]